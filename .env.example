# Template only: no real credentials. Import values via the cloud secret manager.
# Node does not automatically load this file. Set runtime AND build variables.
NODE_ENV=production
PORT=8080
TZ=Asia/Jerusalem
LOG_LEVEL=info

# Keep disabled until the previous worker is stopped and cutover is approved.
CLOUD_CUTOVER_APPROVED=0

# Approved external public identity for the complete Render service.
PUBLIC_APP_URL=https://yotibot-azbu.onrender.com
GOOGLE_CALENDAR_REDIRECT_URI=https://yotibot-azbu.onrender.com/api/mini-app/calendar/callback
TELEGRAM_WEBHOOK_URL=https://yotibot-azbu.onrender.com/telegram/webhook
CLERK_AUTH_MODE=external

# Required: use the existing production PostgreSQL DB, with TLS as appropriate.
# Never replace it with an empty database or copy development over production.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
SESSION_SECRET=

# AI: configure your selected provider. GROQ is the default.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# External Clerk only: Replit-managed Clerk is not portable to Render.
# Do not swap keys before verifying migration of existing SQL account links.
# Use matching external keys at build time AND runtime. Do not copy GITHUB_PAT.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Optional Google Calendar. Preserve SESSION_SECRET to decrypt existing tokens.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Whop on external hosting requires direct credentials, not Replit connectors.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_PRO_PLAN_ID=
WHOP_UNLIMITED_PLAN_ID=

# Optional boot/access settings. Existing production owner is stored in SQL.
TELEGRAM_ALLOWED_CHAT_ID=
AH_SHELI_DATA_DIR=
WEB_REPL_RENEWAL=

# Optional Replit-specific storage settings. These are NOT portable credentials.
# If upload features need them externally, configure a storage adapter first.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional best-effort self-ping; not a guarantee of reminder timing.
# Leave empty on always-on hosting unless specifically needed.
SELF_KEEP_ALIVE_URL=
