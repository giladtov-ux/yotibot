# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
.cache/
.env
.env.*
!.env.example

.agents/
attached_assets/
generated-artifacts/
artifacts/api-server/playwright-report/
artifacts/api-server/test-results/
artifacts/api-server/tests/browser/results/
artifacts/api-server/tests/browser/html-report/
