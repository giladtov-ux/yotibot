modules = ["python-base-3.13", "nodejs-24", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd phase-68-fix-restore-project-structure/yotibot-fix-restore-project-structure && env -u TELEGRAM_BOT_TOKEN -u TELEGRAM_WEBHOOK_URL -u CLOUD_CUTOVER_APPROVED NODE_ENV=development PORT=5000 BASE_PATH=/ pnpm --filter @workspace/api-server run start"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
